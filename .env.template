# Copy to .env and fill in for local dev only.
# Production never reads this file: keys are derived in the enclave.
NODE_ENV=development

# Hosts (with port) of the UIs allowed to request a SIWE signature, comma-separated.
# Required in production. Defaults to localhost,localhost:3000 elsewhere.
SIWE_DOMAIN=

# Browser origins allowed to call the API (scheme://host[:port]), comma-separated.
# Unset allows no cross-origin caller; non-browser clients are unaffected.
CORS_ORIGINS=http://localhost:5173

# Chest file location, size cap and per-address quota (bytes). Default to
# <cwd>/chest.json, 50 MB and 1 MiB.
# CHEST_PATH=
# CHEST_MAX_BYTES=
# CHEST_ADDRESS_QUOTA_BYTES=

# Gateway hostnames the in-enclave TLS certificate is issued for, comma-separated.
# Required in production, e.g. <app-id>-3000s.<gateway-domain>. Unused in dev,
# which serves secrets/tls.cert. See docs/PHALA_CONFIG.md
TLS_ALT_NAMES=

# Keys are derived inside the enclave from the dstack KMS, never set here.
# Locally, run the dstack simulator and point to its socket (or http URL).
# Forbidden in production. See docs/KEY_DERIVATION.md
DSTACK_SIMULATOR_ENDPOINT=
