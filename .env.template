# Copy to .env and fill in for local dev only.
# In production, all secrets come from the KMS — never from this file.
NODE_ENV=development
KMS_URL=https://your-kms.example.com/release

# Hosts (with port) of the UIs allowed to request a SIWE signature, comma-separated.
# Required in production. Defaults to localhost,localhost:3000 elsewhere.
SIWE_DOMAIN=

# Chest file location and size cap (bytes). Default to <cwd>/chest.json and 50 MB.
# CHEST_PATH=
# CHEST_MAX_BYTES=

# ML-KEM-1024 Admin Keypair (quantum-resistant encryption)
# Generate with: pnpm ts-node scripts/generate-admin-keypair.ts
# The public key will be exposed in /chest/attestation responses
# The private key MUST stay secret - only accessible inside the TEE
ADMIN_MLKEM_PUBLIC_KEY=
ADMIN_MLKEM_PRIVATE_KEY=